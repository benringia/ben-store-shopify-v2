<link
  rel="stylesheet"
  href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css"
/>
<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>

{% assign selected_variant = product.selected_or_first_available_variant %}


<style>
    .swiper-button-next, .swiper-button-prev {
        color: black;
        top: auto !important;
        height: 20px;
    }

    .swiper-button-prev::after, .swiper-button-next::after {
        font-size: 20px;
    }

    .swiper-pagination {
        bottom: 0 !important;
    }

    .swiper-pagination-bullet-active {
        background: black !important;
    }

    .product--info {
        height: fit-content;
    }
</style>


<div class="max-w-6xl mx-auto my-8">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
        <div class="product--medias">
            <div class="hidden md:block">
                {% for media in product.media %}
                    <div class="h-100 overflow-hidden p-2">
                        {% render 'product-media', media: media %}
                    </div>
                {% endfor %}
            </div>
            
            <!--MOBILE-->
            <div class="md:hidden">
                <div class="swiper products h-[22rem]">
                    <div class="swiper-wrapper">
                        {% for media in product.media %}
                            <div class="swiper-slide">
                                <div class="h-80 overflow-hidden p-2">
                                    {% render 'product-media', media: media %}
                                </div>
                            </div>
                        {% endfor %}
                    </div>

                    <div class="swiper-pagination"></div>
                    <div class="swiper-button-prev"></div>
                    <div class="swiper-button-next"></div>
                </div>
            </div>
        </div>

        <div class="product--info sticky top-5 p-2">
            {% form 'product', product, id: 'product-form' %}
                <input type="hidden" name="id" value="{{ selected_variant.id }}">
                <div class="my-3">
                    <span class="text-xs text-gray-500">{{ product.vendor }}</span>
                </div>

                <div class="my-3">
                    <h1 class="text-3xl text-gray-900">
                        {{ product.title }}
                    </h1>
                </div>

                <div class="my-3">
                    {% assign product_price = selected_variant %}
                    
                    <span id="compare-price" class="text-base text-gray-500 line-through">
                        {{ product_price.compare_at_price | money }}
                    </span>

                    <span id="main-price" class="text-lg text-gray-900">
                        {{ product_price.price | money }}
                    </span>

                    <span 
                        id="sale-badge"
                        class="px-5 py-1 text-sm font-bold bg-red-500 rounded-full text-white mx-4"
                        {% unless product_price.price < product_price.compare_at_price %}
                            style="display:none"
                        {% endunless %}
                    >
                        Sale
                    </span>
                </div>


                <div class="my-3">
                    {% unless product.has_only_default_variant %}
                        <div data-url="{{ product.url }}" data-section="{{ section.id }}">
                            {% for option in product.options_with_values %}
                                <label for="Option-{{ section.id }}-{{ forloop.index0 }}"> {{ option.name }} </label>

                                <div class="my-2">
                                    <select 
                                        name="options[{{ option.name | escape }}]" 
                                        id="Option-{{ section.id }}-{{ forloop.index0 }}" 
                                        class="w-full border border-gray-200 py-3 px-3" >
                                        
                                        {% for value in option.values %}
                                            <option 
                                                value="{{ value | escape}}"
                                                {% if option.selected_value == value %}
                                                    selected="selected"
                                                {% endif %}
                                            >
                                                {{ value }}
                                            </option>
                                        {% endfor %}
                                    </select>
                                </div>
                            {% endfor %}
                        </div>
                    {% endunless %}
                </div>


                <div class="my-3">
                    <label for="Quantity-{{ section.id }}">Quantity</label>

                    <div class="my-2">
                        <input class="w-full border border-gray-200 p-3" type="number" name="quantity" id="Quantity-{{ section.id }}" value="1" min="1">
                    </div>
                </div>

                <div class="my-3">
                    <div class="my-2">
                        <p class="text-gray-700">{{ product.description }}</p>
                    </div>
                </div>

                <div class="my-3">
                        {% if selected_variant.available == false %}
                            <button disabled type="submit" name="add" class="w-full px-6 py-4 bg-gray-500 text-white  rounded-sm my-2 pointer-events-none">
                                Sold out
                            </button>
                        {% else %}
                            <button type="submit" name="add" class="w-full px-6 py-4 bg-gray-900 text-white rounded-sm my-2 hover:bg-gray-700">
                                Add to Cart
                            </button>
                        {% endif %}
                    
                </div>

            {% endform %}
        </div>
    </div>
</div>


<script>
    const swiper = new Swiper('.swiper.products', {
        direction: 'horizontal',
        pagination: {
            el: '.swiper-pagination'
        },
        navigation: {
            prevEl: '.swiper-button-prev',
            nextEl: '.swiper-button-next'
        }
    })
</script>


<script>
document.addEventListener('DOMContentLoaded', function () {

    // 1. Product data from Shopify
    const productData = {{ product | json }};

    const form = document.getElementById('product-form');
    const variantInput = form.querySelector('input[name="id"]');
    const selects = form.querySelectorAll('select');

    // 2. Price elements
    const mainPrice = document.getElementById('main-price');
    const comparePrice = document.getElementById('compare-price');
    const saleBadge = document.getElementById('sale-badge');

    function updateVariant() {
        let selectedOptions = [];

        selects.forEach(select => {
            selectedOptions.push(select.value);
        });

        // Find variant based on selected options
        const matchedVariant = productData.variants.find(variant =>
            JSON.stringify(variant.options) === JSON.stringify(selectedOptions)
        );

        if (!matchedVariant) return;

        // Update variant ID (fix add to cart issue)
        variantInput.value = matchedVariant.id;

        // Update main price
        mainPrice.innerHTML = Shopify.formatMoney(matchedVariant.price, "{{ shop.money_format }}");

        // Update compare-at price & sale badge
        if (matchedVariant.compare_at_price > matchedVariant.price) {
            comparePrice.innerHTML = Shopify.formatMoney(matchedVariant.compare_at_price, "{{ shop.money_format }}");
            comparePrice.style.display = "inline";
            saleBadge.style.display = "inline-block";
        } else {
            comparePrice.style.display = "none";
            saleBadge.style.display = "none";
        }

        // Optional: disable Add to Cart when sold out
        const addBtn = form.querySelector('button[name="add"]');
        if (!matchedVariant.available) {
            addBtn.disabled = true;
            addBtn.innerText = "Sold Out";
        } else {
            addBtn.disabled = false;
            addBtn.innerText = "Add to Cart";
        }

        console.log("Variant changed to:", matchedVariant.id);
    }

    // Run on dropdown change
    selects.forEach(select => {
        select.addEventListener('change', updateVariant);
    });

});
</script>
