<div class="w-full py-6 px-3">
    <div class=" bg-white shadow-lg rounded-lg overflow-hidden">
        <a href="{{ product_name.url }}" class="">
            {% if product_name.featured_image %}
            <div class="h-80 overflow-hidden">
                <img class="w-full h-full object-cover transition duration-300 ease-in-out hover:scale-105 transform" src="{{ product_name.featured_image | img_url: 'medium' }}" alt="{{ product_name.featured_image.alt }}">
            </div>
            {% else %}
                {{ 'product-1' | placeholder_svg_tag: 'w-full h-full object-cover bg-gray-100' }}
            {% endif %}
        </a>
       
       <div class="flex flex-col p-4">
        {% if section.settings.show_vendor %}
            <span class="text-sm text-gray-400" >
                {{ product_name.vendor }}  
            </span>
        {% endif %}
        
        <a class="text-gray-700 uppercase font-medium" href="{{ product_name.url }}">{{ product_name.title }}</a>
        <p class="text-gray-500">
            {{ product_name.price | money }}
        </p>
       </div>
        
    </div>
</div>